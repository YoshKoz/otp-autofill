{
  "manifest_version": 2,
  "name": "OTP Autofill",
  "version": "1.0",
  "description": "Auto-fills email verification codes from local Thunderbird into the login page you opened. Acts only while you are on an OTP page.",
  "browser_specific_settings": {
    "gecko": {
      "id": "otp-autofill@yoshkoz.local"
    }
  },
  "permissions": [
    "nativeMessaging",
    "activeTab"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
